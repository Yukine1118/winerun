# 複製這個檔案成 .env.local，再填入你 Supabase 專案的值
# （Supabase 後台 → Project Settings → API Keys / Data API）

# 專案網址，例如 https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key（sb_publishable_ 開頭）：公開的，放在瀏覽器沒關係
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key（sb_secret_ 開頭）：⚠️ 秘密！只給伺服器用，不能外流、不能 commit
SUPABASE_SECRET_KEY=
